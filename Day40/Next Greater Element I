class Solution {
public:
    vector<int> nextGreaterElement(vector<int>& nums1, vector<int>& nums2) {
        vector<int> ans(nums1.size(), -1); // Initialize result with -1
    
    // Iterate through nums1
    for (int i = 0; i < nums1.size(); ++i) {
        bool found = false;
        
        // Find the position of nums1[i] in nums2
        int pos = 0;
        while (nums2[pos] != nums1[i]) {
            ++pos;
        }
        
        // Search for the next greater element in nums2
        for (int j = pos + 1; j < nums2.size(); ++j) {
            if (nums2[j] > nums1[i]) {
                ans[i] = nums2[j];
                found = true;
                break;
            }
        }
    }
    
    return ans;
    }
};
