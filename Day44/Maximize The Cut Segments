class Solution
{
    public:
    // Function to find the maximum number of cuts.
    int maximizeTheCuts(int n, int x, int y, int z)
    {
        // Initialize the dp array with -1 (indicating no cuts are possible initially).
        vector<int> dp(n + 1, -1);
        
        // Base case: 0 length line segment means 0 cuts.
        dp[0] = 0;
        
        // Iterate through all lengths from 1 to n.
        for(int i = 1; i <= n; i++)
        {
            // Check if a cut of length x can be made.
            if(i >= x && dp[i - x] != -1)
                dp[i] = max(dp[i], dp[i - x] + 1);
            
            // Check if a cut of length y can be made.
            if(i >= y && dp[i - y] != -1)
                dp[i] = max(dp[i], dp[i - y] + 1);
            
            // Check if a cut of length z can be made.
            if(i >= z && dp[i - z] != -1)
                dp[i] = max(dp[i], dp[i - z] + 1);
        }
        
        // If dp[n] is still -1, it means no cuts were possible, so return 0.
        return dp[n] == -1 ? 0 : dp[n];
    }
};
