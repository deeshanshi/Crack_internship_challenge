class Solution {
public:
    int minAdjustmentCost(int A[], int n, int target) {
        const int M = 100;  // maximum possible value for any element
        vector<vector<int>> dp(n, vector<int>(M + 1, INT_MAX));  // dp array

        // Initialize the dp for the first element
        for (int j = 0; j <= M; j++) {
            dp[0][j] = abs(A[0] - j);
        }

        // Fill the dp table
        for (int i = 1; i < n; i++) {
            for (int j = 0; j <= M; j++) {
                int minCost = INT_MAX;
                // For the current element, check all possible values within the target range from previous element
                for (int k = max(0, j - target); k <= min(M, j + target); k++) {
                    minCost = min(minCost, dp[i-1][k]);
                }
                dp[i][j] = minCost + abs(A[i] - j);
            }
        }

        // Find the minimum value in the last row of dp
        int result = INT_MAX;
        for (int j = 0; j <= M; j++) {
            result = min(result, dp[n-1][j]);
        }

        return result;
    }
