class Solution {
public:
    bool isPossible(int arr[], int n, int m, long long curr_min) {
        int studentsRequired = 1;
        long long current_sum = 0;

        for (int i = 0; i < n; i++) {
            // If a single book has more pages than curr_min, it can't be assigned
            if (arr[i] > curr_min)
                return false;

            // If current sum + arr[i] exceeds curr_min, assign this book to a new student
            if (current_sum + arr[i] > curr_min) {
                studentsRequired++;
                current_sum = arr[i];

                // If more students are required than available, return false
                if (studentsRequired > m)
                    return false;
            } else {
                // Otherwise, continue adding pages to the current student
                current_sum += arr[i];
            }
        }
        return true;
    }

    long long findPages(int n, int arr[], int m) {
        // Edge case: if students are more than books, return -1
        if (m > n)
            return -1;

        long long start = *max_element(arr, arr + n);
        long long end = accumulate(arr, arr + n, 0LL);
        long long result = -1;

        while (start <= end) {
            long long mid = start + (end - start) / 2;

            // Check if it's possible to allocate books such that no student has to read more than mid pages
            if (isPossible(arr, n, m, mid)) {
                result = mid;
                end = mid - 1;  // Try for a smaller maximum
            } else {
                start = mid + 1;  // Increase the allowed maximum pages
            }
        }
        return result;
    }
};
