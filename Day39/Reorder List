class Solution {
public:
    void reorderList(Node* head) {
        if (!head || !head->next) return; // Edge case: empty or single node list
        
        // Step 1: Find the middle of the list
        Node* slow = head;
        Node* fast = head;
        while (fast && fast->next) {
            slow = slow->next;
            fast = fast->next->next;
        }

        // Step 2: Reverse the second half of the list
        Node* prev = NULL;
        Node* curr = slow;
        while (curr) {
            Node* nextTemp = curr->next;
            curr->next = prev;
            prev = curr;
            curr = nextTemp;
        }

        // Step 3: Merge the two halves
        Node* first = head;
        Node* second = prev; // This is the head of the reversed second half
        while (second->next) { // Ensure we don't merge the two halves indefinitely
            Node* tmp1 = first->next;
            Node* tmp2 = second->next;

            first->next = second;
            second->next = tmp1;

            first = tmp1;
            second = tmp2;
        }
    }
};
