class Solution {
public:
    int optimalSearchTree(int keys[], int freq[], int n) {
        // Declare DP table and sumFreq table
        std::vector<std::vector<int>> dp(n, std::vector<int>(n, 0));
        std::vector<std::vector<int>> sumFreq(n, std::vector<int>(n, 0));

        // Fill the sumFreq table for frequency sums
        for (int i = 0; i < n; i++) {
            sumFreq[i][i] = freq[i];
            for (int j = i + 1; j < n; j++) {
                sumFreq[i][j] = sumFreq[i][j-1] + freq[j];
            }
        }

        // Fill the dp table using the bottom-up approach
        for (int len = 1; len <= n; len++) {  // len is the length of the range
            for (int i = 0; i <= n - len; i++) {
                int j = i + len - 1;
                dp[i][j] = INT_MAX;

                // Try making each key `r` the root
                for (int r = i; r <= j; r++) {
                    int cost = (r > i ? dp[i][r-1] : 0) +
                               (r < j ? dp[r+1][j] : 0) +
                               sumFreq[i][j];
                    dp[i][j] = std::min(dp[i][j], cost);
                }
            }
        }

        // The minimum cost to construct the optimal BST is in dp[0][n-1]
        return dp[0][n-1];
    }
};

