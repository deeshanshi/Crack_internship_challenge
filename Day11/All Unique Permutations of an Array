sort(arr.begin(), arr.end());

        // A set to store the unique permutations
        set<vector<int>> unique_permutations;

        // Generate all permutations and store only unique ones in the set
        do {
            unique_permutations.insert(arr);
        } while (next_permutation(arr.begin(), arr.end()));

        // Convert the set to a vector of vectors
        vector<vector<int>> result(unique_permutations.begin(), unique_permutations.end());

        return result;
    }
};
