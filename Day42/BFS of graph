class Solution {
  public:
    // Function to return Breadth First Traversal of the given graph.
    vector<int> bfsOfGraph(int V, vector<int> adj[]) {
        vector<int> bfs;       // To store the BFS traversal result.
        vector<bool> visited(V, false); // To track visited nodes.
        queue<int> q;          // Queue for BFS.

        // Start BFS from node 0.
        q.push(0);
        visited[0] = true;

        while (!q.empty()) {
            int node = q.front();
            q.pop();

            // Append the node to the BFS result.
            bfs.push_back(node);

            // Explore the neighbors of the current node.
            for (int neighbor : adj[node]) {
                if (!visited[neighbor]) {
                    visited[neighbor] = true;
                    q.push(neighbor);
                }
            }
        }

        return bfs;
    }
};
