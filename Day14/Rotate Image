        // Group words by their sorted characters
        for (const string& word : string_list) {
            string sorted_word = word;
            sort(sorted_word.begin(), sorted_word.end());
            if (anagram_map.find(sorted_word) == anagram_map.end()) {
                appearance_order.push_back(sorted_word);
            }
            anagram_map[sorted_word].push_back(word);
        }

        vector<vector<string>> result;

        // Collect groups based on their first appearance order
        for (const string& sorted_word : appearance_order) {
            vector<string>& group = anagram_map[sorted_word];
